# Uso de módulos de la biblioteca estándar.

importar matematicas
desde cadenas importar mayusculas, dividir
desde sistema importar argv

imprimir(f"π = {matematicas.PI}")
imprimir(f"√2 = {matematicas.raiz(2)}")
imprimir(f"sen(π/2) = {matematicas.sen(matematicas.PI / 2)}")

frase = "hola mundo desde cornamusa"
imprimir(mayusculas(frase))
imprimir(dividir(frase, " "))

si longitud(argv) > 1:
    imprimir(f"Argumentos recibidos: {argv[1:]}")
sino:
    imprimir("Sin argumentos.")
