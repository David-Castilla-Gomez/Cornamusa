# Uso de módulos de la biblioteca estándar.

importar matematicas
desde cadenas importar mayusculas_ascii, separar

imprimir(f"π = {matematicas.PI}")
imprimir(f"√2 = {matematicas.raiz(2)}")
imprimir(f"seno(π/2) = {matematicas.seno(matematicas.PI / 2)}")

frase = "hola mundo desde cornamusa"
imprimir(mayusculas_ascii(frase))
imprimir(separar(frase, " "))
