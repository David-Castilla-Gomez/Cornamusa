# Modulo `jwt` (v1.67 + v1.70): JSON Web Tokens con HMAC-SHA-256.
#
# Demuestra el ciclo completo de un sistema de autenticacion basico:
#   - Servidor firma un token con su clave secreta.
#   - Cliente recibe el token (lo guarda en cookie/header).
#   - Servidor lo verifica en peticiones posteriores.
#   - v1.70: validacion de claims temporales (exp, nbf).
#
# Construido sobre las piezas:
#   - json    (v1.9)   serializa el payload.
#   - base64  (v1.66)  variante URL-safe para cada parte.
#   - hashing (v1.65)  HMAC-SHA-256 para la firma.

importar jwt

# ─── 1. Login: servidor firma un token ──────────────────────────
CLAVE_SERVIDOR = "mi-clave-super-secreta-no-compartir"

usuario = {
    "id": 42,
    "email": "ada@ejemplo.com",
    "roles": ["admin", "editor"],
    "iat": 1735689600,                    # issued at (timestamp)
    "exp": 1735689600 + 60 * 60 * 24,     # +24h
}

token = jwt.codificar(usuario, CLAVE_SERVIDOR)
imprimir("Token emitido:")
imprimir(token)
imprimir(f"\nlongitud: {longitud(token)} chars (3 partes . separadas)")

# ─── 2. Cliente envia el token de vuelta ────────────────────────
# (En un sistema real iria en Authorization: Bearer <token>.)
peticion_authorization = "Bearer " + token
imprimir("\nAuthorization header:", peticion_authorization)

# ─── 3. Servidor valida y extrae el payload ─────────────────────
# Extraer el token del header (saltarse "Bearer ").
token_recibido = peticion_authorization[7:]

intentar:
    payload = jwt.decodificar(token_recibido, CLAVE_SERVIDOR)
    imprimir("\nAutenticado OK:")
    imprimir("  Usuario id:", payload["id"])
    imprimir("  Email:", payload["email"])
    imprimir("  Roles:", payload["roles"])
atrapar ErrorDeValor como e:
    imprimir("Token invalido:", e)
fin intentar

# ─── 4. Atacante intenta alterar el payload ─────────────────────
# Modifica el segundo segmento (payload) — la firma deja de cuadrar.
partes = token
# Token alterado de juguete: cambiar el ultimo char antes de la firma.
token_alterado = token[:60] + "X" + token[61:]

imprimir(f"\nToken alterado verifica? {jwt.verificar(token_alterado, CLAVE_SERVIDOR)}")

# ─── 5. Servidor con clave distinta no acepta ───────────────────
# Esto es lo que protege contra otros servicios firmando tokens
# para nuestro usuario.
imprimir(f"Con otra clave verifica? {jwt.verificar(token, 'otra-clave-distinta')}")

# ─── 6. Atajo verificar() devuelve booleano (no lanza) ──────────
# Util en condicionales sin necesitar try/except.
si jwt.verificar(token, CLAVE_SERVIDOR):
    imprimir("\nVerificacion booleana: OK")
sino:
    imprimir("\nVerificacion booleana: rechazado")
fin si

# ─── 7. v1.70: validar claims temporales (exp, nbf) ─────────────
# `decodificar()` solo valida la firma — el caller decide si el
# token aun esta vigente. `decodificar_y_validar()` es el atajo que
# combina firma + exp + nbf en una sola llamada.

# Simulemos dos momentos en el tiempo:
ahora_antes_de_caducar = 1735689600 + 60 * 60         # 1h tras emision
ahora_tras_caducar     = 1735689600 + 60 * 60 * 48    # 48h tras emision

# El token original tiene exp = iat + 24h.
intentar:
    p = jwt.decodificar_y_validar(token, CLAVE_SERVIDOR, ahora_antes_de_caducar)
    imprimir("\nValidado a 1h: usuario id =", p["id"])
atrapar ErrorDeValor como e:
    imprimir("Error inesperado:", e)
fin intentar

intentar:
    jwt.decodificar_y_validar(token, CLAVE_SERVIDOR, ahora_tras_caducar)
    imprimir("Bug: deberia haber lanzado")
atrapar ErrorDeValor como e:
    imprimir("Validado a 48h: rechazado correctamente —", e)
fin intentar

# Token con nbf (not-before) en el futuro: aun no es valido.
token_futuro = jwt.codificar({"sub": "futuro", "nbf": 9999999999}, CLAVE_SERVIDOR)
intentar:
    jwt.decodificar_y_validar(token_futuro, CLAVE_SERVIDOR, 1735689600)
    imprimir("Bug: nbf no rechazo")
atrapar ErrorDeValor como e:
    imprimir("nbf futuro: rechazado —", e)
fin intentar

# Helper jwt.expirado() en aislamiento (sin clave, sin firma).
imprimir("\njwt.expirado(payload, ahora_tras_caducar):", jwt.expirado(usuario, ahora_tras_caducar))
sin_exp = {"sub": "x"}
imprimir("jwt.expirado(payload sin exp, ahora):", jwt.expirado(sin_exp, 999999))
