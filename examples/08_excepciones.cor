# Manejo de excepciones: división segura y lectura de archivo.
#
# Las excepciones built-in son: Excepcion, ErrorAritmetico, ErrorDeTipo,
# ErrorDeValor, ErrorDeIndice, ErrorDeClave, ErrorDeNombre,
# ErrorDeSistema, ErrorDeIO, ErrorDeIteracion, ErrorDeAtributo.

importar archivos

funcion dividir_seguro(a, b):
    intentar:
        retornar a / b
    atrapar ErrorAritmetico como e:
        imprimir(f"No se puede dividir {a} entre cero ({e})")
        retornar nulo
    fin intentar
fin funcion

imprimir(dividir_seguro(10, 2))
imprimir(dividir_seguro(10, 0))

# Lectura de archivo: archivos.leer(ruta) lanza ErrorDeIO si no existe.
intentar:
    contenido = archivos.leer("datos_inexistente.txt")
    imprimir(contenido)
atrapar ErrorDeIO como e:
    imprimir(f"No se pudo leer: {e}")
fin intentar
