# 29_oop_avanzado.cor — dunders avanzados v1.3.
#
# Cornamusa v1.3 completa el modelo OOP:
#   - operadores reflejados (`5 + V` invoca `__sumar_derecho__` si
#     la suma normal no aplica),
#   - `__llamar__` (instancias callable),
#   - `__longitud__` (`longitud(obj)` invoca el dunder).

# 1. Vector con suma reflejada: la suma es conmutativa, así que
#    `5 + v` debe dar el mismo resultado que `v + 5`.
clase Vec:
    funcion __iniciar__(yo, x):
        yo.x = x
    fin funcion

    funcion __sumar__(yo, otro):
        si tipo(otro) == "instancia":
            retornar Vec(yo.x + otro.x)
        fin si
        retornar Vec(yo.x + otro)
    fin funcion

    funcion __sumar_derecho__(yo, otro):
        # Aprovechamos la conmutatividad de la suma.
        retornar yo + otro
    fin funcion

    funcion __cadena__(yo):
        retornar f"Vec({yo.x})"
    fin funcion
fin clase

v = Vec(10)
imprimir(v + 5)                 # Vec(15)
imprimir(5 + v)                 # Vec(15) via __sumar_derecho__
imprimir(v + v + 100)           # Vec(120)

# 2. Multiplicador como instancia callable.
clase Multiplicador:
    funcion __iniciar__(yo, factor):
        yo.factor = factor
    fin funcion

    funcion __llamar__(yo, n):
        retornar n * yo.factor
    fin funcion
fin clase

doblar = Multiplicador(2)
triplicar = Multiplicador(3)

imprimir(doblar(5))             # 10
imprimir(triplicar(5))          # 15

# Compose-style: triplicar(doblar(7)) = triplicar(14) = 42
imprimir(triplicar(doblar(7)))

# 3. Pila con __longitud__.
clase Pila:
    funcion __iniciar__(yo):
        yo.items = []
    fin funcion

    funcion meter(yo, x):
        agregar(yo.items, x)
    fin funcion

    funcion sacar(yo):
        retornar quitar(yo.items)
    fin funcion

    funcion __longitud__(yo):
        retornar longitud(yo.items)
    fin funcion

    funcion __cadena__(yo):
        retornar f"Pila({yo.items})"
    fin funcion
fin clase

p = Pila()
p.meter(1)
p.meter(2)
p.meter(3)

imprimir(p)                     # Pila([1, 2, 3])
imprimir(longitud(p))           # 3 via __longitud__
p.sacar()
imprimir(longitud(p))           # 2

# 4. Counter como callable + estado interno (closure de instancia).
clase Contador:
    funcion __iniciar__(yo):
        yo.cuenta = 0
    fin funcion

    funcion __llamar__(yo):
        yo.cuenta = yo.cuenta + 1
        retornar yo.cuenta
    fin funcion
fin clase

c = Contador()
imprimir(c())                   # 1
imprimir(c())                   # 2
imprimir(c())                   # 3
imprimir(f"contador interno: {c.cuenta}")
