# Ejemplo 56 — Generadores con `producir` (v1.31)
#
# Una función que contiene `producir` se convierte en generador:
# llamarla NO ejecuta el cuerpo, sino que devuelve un objeto
# generador. Iterar con `para...en...` lo reanuda hasta el próximo
# `producir`. El estado (locales + IP) se preserva entre yields.

imprimir("=== generadores (v1.31) ===")
imprimir("")

# ─── Caso 1: contar perezoso ───
funcion contar(ini, tope):
    i = ini
    mientras i <= tope:
        producir i
        i = i + 1
    fin mientras
fin funcion

imprimir("1) contar perezoso")
imprimir("  tipo:", tipo(contar(1, 5)))
para v en contar(1, 5):
    imprimir("  ", v)
fin para
imprimir("")

# ─── Caso 2: Fibonacci infinito ───
funcion fib():
    a = 0
    b = 1
    mientras verdadero:
        producir a
        c = a + b
        a = b
        b = c
    fin mientras
fin funcion

imprimir("2) Fibonacci infinito (rompemos con `romper`)")
i = 0
para n en fib():
    si i >= 10:
        romper
    fin si
    imprimir("  fib", i, "=", n)
    i = i + 1
fin para
imprimir("")

# ─── Caso 3: pipeline lazy ───
funcion pares_naturales():
    n = 0
    mientras verdadero:
        producir n * 2
        n = n + 1
    fin mientras
fin funcion

funcion tomar(gen, n):
    resultado = []
    i = 0
    para v en gen:
        si i >= n:
            romper
        fin si
        agregar(resultado, v)
        i = i + 1
    fin para
    retornar resultado
fin funcion

imprimir("3) tomar(pares_naturales(), 6)")
imprimir("  ", tomar(pares_naturales(), 6))
imprimir("")

# ─── Caso 4: filtrar perezoso ───
funcion filtrar(gen, pred):
    para v en gen:
        si pred(v):
            producir v
        fin si
    fin para
fin funcion

es_par = lambda x: x % 2 == 0
imprimir("4) filtrar primeros pares de fib")
imprimir("  ", tomar(filtrar(fib(), es_par), 5))
imprimir("")

# ─── Caso 5: generador agotado ───
funcion una_vez():
    producir "primera y unica"
fin funcion

imprimir("5) generador agotado tras consumirlo")
g = una_vez()
para v en g:
    imprimir("  iter 1:", v)
fin para
para v en g:
    imprimir("  iter 2:", v, "(no debe imprimir)")
fin para
imprimir("  fin")
imprimir("")

# ─── Caso 6: producir desde (delegación, v1.33) ───
funcion hojas():
    producir 1
    producir 2
fin funcion

funcion arbol():
    producir 0
    producir desde hojas()      # delega al sub-generador
    producir desde [3, 4, 5]    # también funciona con iterables
    producir 6
fin funcion

imprimir("6) producir desde (delegacion de generadores)")
linea_vals = []
para v en arbol():
    agregar(linea_vals, v)
fin para
imprimir("  ", linea_vals)
imprimir("")

# ─── Caso 7: generator expressions inline (v1.34) ───
imprimir("7) generator expressions `(expr para v en it)`")

# genex directa: lazy, no materializa
cuadrados = (n * n para n en rango(1, 7))
imprimir("  tipo:", tipo(cuadrados))
vals = []
para v en cuadrados:
    agregar(vals, v)
fin para
imprimir("  cuadrados 1..6:", vals)

# genex con guarda, pasada directo a un para
imprimir("  pares de 0..19:")
suma_pares = 0
para v en (n para n en rango(20) si n % 2 == 0):
    suma_pares = suma_pares + v
fin para
imprimir("    suma =", suma_pares)

# genex captura variable externa como upvalue
funcion escalador(factor):
    # la genex captura `factor` del scope de escalador
    retornar (x * factor para x en [1, 2, 3, 4])
fin funcion
imprimir("  escalador(10):", tomar(escalador(10), 4))
imprimir("")

imprimir("=== fin ejemplo 56 ===")
