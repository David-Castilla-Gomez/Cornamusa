# Conteo de vocales — segundo programa "jugable" v0.4.
#
# Demuestra:
#   - Iteracion `para letra en cadena` (UTF-8 code points).
#   - Acumulador con asignacion aumentada `+=`.
#   - Comparacion logica encadenada via `o`.
#   - Built-in longitud() sobre cadena UTF-8.

funcion contar_vocales(texto):
    total = 0
    para letra en texto:
        si letra == "a" o letra == "e" o letra == "i" o letra == "o" o letra == "u":
            total += 1
        fin si
    fin para
    retornar total
fin funcion

palabra = "murcielago"
imprimir(palabra, "tiene", contar_vocales(palabra), "vocales y mide",
         longitud(palabra), "letras")

palabra = "psicologia"
imprimir(palabra, "tiene", contar_vocales(palabra), "vocales y mide",
         longitud(palabra), "letras")
