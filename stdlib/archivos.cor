# Cornamusa stdlib: archivos.cor
#
# Lectura y escritura de archivos. Wrapper sobre los built-ins
# `archivo_leer`, `archivo_escribir`, `archivo_lineas`,
# `archivo_existe`, `archivo_agregar`.
#
# Uso:
#   importar archivos
#
#   # Leer todo el contenido
#   texto = archivos.leer("config.txt")
#
#   # Escribir (trunca si existe)
#   archivos.escribir("salida.txt", "hola mundo")
#
#   # Lista de líneas (sin '\n' final, salvo CRLF que conserva '\r')
#   para linea en archivos.lineas("datos.txt"):
#       imprimir(linea)
#   fin para
#
#   # Comprobar existencia antes de leer
#   si archivos.existe("config.txt"):
#       texto = archivos.leer("config.txt")
#   fin si
#
#   # Append (útil para logs)
#   archivos.agregar("log.txt", f"[{ahora()}] evento\n")
#
# Manejo de errores: si la operación falla (archivo no existe, sin
# permisos, OOM), el programa termina con error de runtime. Los
# errores no son atrapables vía `intentar/atrapar` en v1.8 — usa
# `archivos.existe(ruta)` para chequear antes de leer.
#
# Encoding: bytes crudos. Cornamusa cadenas son UTF-8; estas funciones
# no validan ni convierten. Si el archivo es UTF-16 u otro encoding,
# los bytes llegan como cadenas con secuencias mal formadas.

funcion leer(ruta):
    retornar archivo_leer(ruta)
fin funcion

funcion escribir(ruta, contenido):
    archivo_escribir(ruta, contenido)
fin funcion

funcion lineas(ruta):
    retornar archivo_lineas(ruta)
fin funcion

funcion existe(ruta):
    retornar archivo_existe(ruta)
fin funcion

funcion agregar(ruta, contenido):
    archivo_agregar(ruta, contenido)
fin funcion

# ─── Filesystem (v1.97) ─────────────────────────────────────────
#
# `existe` (v1.8) solo retorna verdadero para archivos. Para
# distinguir archivos de directorios, usar `es_directorio`.
#
# `listar` devuelve los nombres de las entradas inmediatas (sin
# recursion, sin "." ni ".."). Lanza ErrorDeIO si la ruta no es
# un directorio o no se puede leer.
#
# `directorio_actual` retorna el cwd como cadena con separadores
# normalizados a "/".
#
# `crear_directorio` crea UN directorio (no recursivo, no "mkdir -p").
# Lanza ErrorDeIO si ya existe o si el padre no existe.

funcion es_directorio(ruta):
    retornar archivo_es_directorio(ruta)
fin funcion

funcion listar(ruta):
    retornar directorio_listar(ruta)
fin funcion

funcion directorio_actual():
    retornar obtener_cwd()
fin funcion

funcion crear_directorio(ruta):
    directorio_crear(ruta)
fin funcion

# v1.99: borrado e info.
#
# `eliminar` quita un archivo. Lanza ErrorDeIO si no existe o si
# la ruta es un directorio (use `eliminar_directorio` para eso).
#
# Nota: `borrar` es palabra reservada del lenguaje (`borrar d[k]`,
# `borrar obj.attr`); por eso usamos `eliminar` aqui.
#
# `eliminar_directorio` quita un directorio VACIO. No es `rm -rf`.
# Lanza ErrorDeIO si no esta vacio o no existe.
#
# `info` devuelve un dict con metadatos:
#   - "tamano": bytes (entero; para directorios es dependiente del
#     sistema, no fiable).
#   - "mtime_epoch_ms": milisegundos desde UNIX epoch (precision
#     por-segundo en Windows; sub-segundo en POSIX).
#   - "es_archivo": booleano.
#   - "es_directorio": booleano.

funcion eliminar(ruta):
    archivo_borrar(ruta)
fin funcion

funcion eliminar_directorio(ruta):
    directorio_borrar(ruta)
fin funcion

funcion info(ruta):
    retornar archivo_info(ruta)
fin funcion

# v1.102: borrado recursivo y creacion de arbol.
#
# `eliminar_arbol(ruta)` (rm -rf):
#   - Si es archivo regular, lo borra (fallback a `eliminar`).
#   - Si es directorio, borra recursivamente todo su contenido y
#     finalmente el propio directorio.
#   - Lanza ErrorDeValor si la ruta es vacia o solo un separador
#     ("/", "\\") — guardrail anti-accidente.
#   - Lanza ErrorDeIO si la ruta no existe.
#
# `crear_arbol(ruta)` (mkdir -p):
#   - Crea el directorio creando padres intermedios si faltan.
#   - Idempotente: si la ruta ya existe como directorio, no falla.
#   - Lanza ErrorDeIO si un componente intermedio existe como archivo.

funcion eliminar_arbol(ruta):
    si tipo(ruta) != "cadena":
        lanzar ErrorDeValor(
            "eliminar_arbol: ruta debe ser cadena, no '" + tipo(ruta) + "'")
    fin si
    si longitud(ruta) == 0:
        lanzar ErrorDeValor("eliminar_arbol: ruta vacia rechazada")
    fin si
    si ruta == "/" o ruta == "\\":
        lanzar ErrorDeValor(
            "eliminar_arbol: ruta raiz '" + ruta + "' rechazada por seguridad")
    fin si
    # Si es archivo, fallback a eliminar
    si no archivo_es_directorio(ruta):
        si archivo_existe(ruta):
            archivo_borrar(ruta)
            retornar nulo
        fin si
        lanzar ErrorDeIO("eliminar_arbol: '" + ruta + "' no existe")
    fin si
    # Es directorio: borrar contenido recursivamente
    para entrada en directorio_listar(ruta):
        sub = ruta + "/" + entrada
        si archivo_es_directorio(sub):
            eliminar_arbol(sub)
        sino:
            archivo_borrar(sub)
        fin si
    fin para
    # Finalmente borrar el directorio (ahora vacio)
    directorio_borrar(ruta)
fin funcion


# v1.105: copia de archivos y de arboles.
#
# `copiar(origen, destino)` copia un archivo (bytes literales). El
# destino se trunca si existe. Lanza ErrorDeIO si origen no
# existe o el destino no se puede escribir. NO preserva mtime ni
# permisos (pendiente futura).
#
# `copiar_arbol(origen, destino)` copia recursivamente un arbol
# entero. Crea `destino` y sus padres si faltan (mkdir -p
# implicito). Si `destino` ya existe como directorio, copia DENTRO
# (idempotente sobre dirs existentes). Si `origen` es un archivo
# regular, fallback a `copiar(origen, destino)`. Lanza ErrorDeIO
# si origen no existe.

funcion copiar(origen, destino):
    archivo_copiar(origen, destino)
fin funcion


# v1.111: mover y modificar mtime.
#
# `mover(origen, destino)` renombra/mueve un archivo. ATOMICO en
# el mismo sistema de archivos (rename()). Cross-FS no es atomico
# en POSIX pero Windows MoveFileExA lo gestiona transparentemente.
# Lanza ErrorDeIO si la operacion falla.
#
# `tocar(ruta)` actualiza el mtime al instante actual (como `touch`
# de Unix). Si el archivo no existe, NO lo crea — para crear
# usa `escribir(ruta, "")`.
#
# `set_mtime(ruta, ms)` establece el mtime explicito en milisegundos
# UNIX epoch. Util para preservar mtime al copiar entre sistemas
# o restaurar de backups.

funcion mover(origen, destino):
    archivo_mover(origen, destino)
fin funcion

funcion set_mtime(ruta, mtime_ms):
    archivo_set_mtime(ruta, mtime_ms)
fin funcion

funcion tocar(ruta):
    importar tiempo
    archivo_set_mtime(ruta, tiempo.epoch_ms())
fin funcion


funcion copiar_arbol(origen, destino):
    si tipo(origen) != "cadena" o tipo(destino) != "cadena":
        lanzar ErrorDeValor(
            "copiar_arbol: origen y destino deben ser cadenas")
    fin si
    si longitud(origen) == 0 o longitud(destino) == 0:
        lanzar ErrorDeValor("copiar_arbol: rutas vacias rechazadas")
    fin si
    # Si origen es archivo regular, fallback a copia simple.
    si no archivo_es_directorio(origen):
        si archivo_existe(origen):
            archivo_copiar(origen, destino)
            retornar nulo
        fin si
        lanzar ErrorDeIO("copiar_arbol: '" + origen + "' no existe")
    fin si
    # Asegurar que el directorio destino existe.
    si no archivo_es_directorio(destino):
        crear_arbol(destino)
    fin si
    # Recorrer entradas inmediatas de origen.
    para entrada en directorio_listar(origen):
        sub_origen = origen + "/" + entrada
        sub_destino = destino + "/" + entrada
        si archivo_es_directorio(sub_origen):
            copiar_arbol(sub_origen, sub_destino)
        sino:
            archivo_copiar(sub_origen, sub_destino)
        fin si
    fin para
fin funcion


funcion crear_arbol(ruta):
    si tipo(ruta) != "cadena":
        lanzar ErrorDeValor(
            "crear_arbol: ruta debe ser cadena, no '" + tipo(ruta) + "'")
    fin si
    si longitud(ruta) == 0:
        lanzar ErrorDeValor("crear_arbol: ruta vacia rechazada")
    fin si
    # Normalizar separadores: aceptar \ y /
    normalizada = ""
    para c en ruta:
        si c == "\\":
            normalizada = normalizada + "/"
        sino:
            normalizada = normalizada + c
        fin si
    fin para
    # Construir y crear cada nivel
    # Detectar prefijo absoluto: "/", "C:/", etc.
    acumulado = ""
    inicio = 0
    si normalizada[0] == "/":
        acumulado = "/"
        inicio = 1
    fin si
    # Drive letter Windows: "C:..." — preservar "C:" como prefijo
    si longitud(normalizada) >= 2 y normalizada[1] == ":":
        acumulado = normalizada[0] + ":"
        inicio = 2
        si longitud(normalizada) >= 3 y normalizada[2] == "/":
            acumulado = acumulado + "/"
            inicio = 3
        fin si
    fin si
    # Iterar componentes separados por "/"
    componente = ""
    i = inicio
    n = longitud(normalizada)
    mientras i < n:
        c = normalizada[i]
        si c == "/":
            si longitud(componente) > 0:
                si longitud(acumulado) > 0 y acumulado[longitud(acumulado)-1] != "/":
                    acumulado = acumulado + "/"
                fin si
                acumulado = acumulado + componente
                si no archivo_es_directorio(acumulado):
                    directorio_crear(acumulado)
                fin si
                componente = ""
            fin si
        sino:
            componente = componente + c
        fin si
        i = i + 1
    fin mientras
    # Componente final
    si longitud(componente) > 0:
        si longitud(acumulado) > 0 y acumulado[longitud(acumulado)-1] != "/":
            acumulado = acumulado + "/"
        fin si
        acumulado = acumulado + componente
        si no archivo_es_directorio(acumulado):
            directorio_crear(acumulado)
        fin si
    fin si
fin funcion
