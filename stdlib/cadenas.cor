# Cornamusa stdlib: cadenas.cor
#
# Operaciones sobre cadenas escritas en Cornamusa puro. Las funciones
# que requieren primitivas C avanzadas (mayúsculas correctas con NFC,
# normalización Unicode) llegarán como bindings nativos en versiones
# futuras. La indexación `s[i]` por carácter UTF-8 ya funciona desde
# v0.9.1.
#
# Uso:
#   importar cadenas
#   imprimir(cadenas.repetir("ab", 3))

# Repite una cadena `n` veces.
# v1.61: usa list-buffer + cadena_unir (O(n*|s|)) en vez de
# `resultado += s` que era O(n^2 * |s|).
funcion repetir(s, n):
    si n < 0:
        lanzar ErrorDeValor("repetir requiere n >= 0")
    fin si
    partes = []
    para _ en rango(n):
        agregar(partes, s)
    fin para
    retornar cadena_unir(partes, "")
fin funcion

# Devuelve verdadero si la cadena está vacía.
funcion es_vacia(s):
    retornar longitud(s) == 0
fin funcion

# Concatena una lista de cadenas con un separador entre cada par.
# `partes` es la lista, `sep` la cadena separadora.
# v1.61: delega a la nativa `cadena_unir` (O(n) total). La version
# previa hacia `resultado += sep + parte` que es O(n^2) por la copia
# obligada de cada concatenacion. Speedup ~5x en benchmarks con
# muchos campos cortos (csv, formato.fila, etc.).
funcion unir(partes, sep):
    retornar cadena_unir(partes, sep)
fin funcion

# Devuelve el carácter (cadena de 1) en la posición indicada.
# Indices negativos cuentan desde el final.
funcion caracter(s, i):
    retornar s[i]
fin funcion

# Verifica si `s` empieza con `prefijo`.
funcion empieza_con(s, prefijo):
    np = longitud(prefijo)
    ns = longitud(s)
    si np > ns:
        retornar falso
    fin si
    para i en rango(np):
        si s[i] != prefijo[i]:
            retornar falso
        fin si
    fin para
    retornar verdadero
fin funcion

# Verifica si `s` termina con `sufijo`.
funcion termina_con(s, sufijo):
    nf = longitud(sufijo)
    ns = longitud(s)
    si nf > ns:
        retornar falso
    fin si
    base = ns - nf
    para i en rango(nf):
        si s[base + i] != sufijo[i]:
            retornar falso
        fin si
    fin para
    retornar verdadero
fin funcion

# Devuelve la posición de la primera ocurrencia de `sub` en `s`, o -1
# si no aparece. Posiciones son índices de code points (UTF-8).
funcion indice_de(s, sub):
    ns = longitud(s)
    nb = longitud(sub)
    si nb == 0:
        retornar 0
    fin si
    si nb > ns:
        retornar -1
    fin si
    i = 0
    mientras i <= ns - nb:
        coincide = verdadero
        para j en rango(nb):
            si s[i + j] != sub[j]:
                coincide = falso
            fin si
        fin para
        si coincide:
            retornar i
        fin si
        i = i + 1
    fin mientras
    retornar -1
fin funcion

# Verdadero si `s` contiene `sub`.
funcion contiene(s, sub):
    retornar indice_de(s, sub) >= 0
fin funcion

# Divide `s` en sub-cadenas usando `sep` como separador. Sep vacío
# divide en cada carácter. Retorna lista no-vacía (al menos un
# elemento, incluso si `s` está vacía).
funcion separar(s, sep):
    partes = []
    ns = longitud(s)
    nsep = longitud(sep)
    si nsep == 0:
        # Caso degenerado: split en cada caracter.
        para k en rango(ns):
            agregar(partes, s[k])
        fin para
        retornar partes
    fin si
    inicio = 0
    i = 0
    coincide = falso
    mientras i <= ns - nsep:
        coincide = verdadero
        para j en rango(nsep):
            si s[i + j] != sep[j]:
                coincide = falso
            fin si
        fin para
        si coincide:
            agregar(partes, s[inicio:i])
            i = i + nsep
            inicio = i
        sino:
            i = i + 1
        fin si
    fin mientras
    agregar(partes, s[inicio:])
    retornar partes
fin funcion

# Reemplaza todas las ocurrencias de `viejo` con `nuevo` en `s`.
# Si `viejo` está vacío, devuelve `s` sin cambios.
funcion reemplazar(s, viejo, nuevo):
    si longitud(viejo) == 0:
        retornar s
    fin si
    partes = separar(s, viejo)
    retornar unir(partes, nuevo)
fin funcion

# Convierte ASCII A-Z a a-z. Caracteres no-ASCII se preservan.
funcion minusculas_ascii(s):
    resultado = ""
    n = longitud(s)
    para i en rango(n):
        c = s[i]
        # Comparación de cadenas (1-char). 'A' = 65, 'Z' = 90.
        si c >= "A" y c <= "Z":
            # Construir cadena con código (offset +32).
            # Workaround sin built-in chr/ord: lookup table.
            resultado = resultado + _ascii_a_min(c)
        sino:
            resultado = resultado + c
        fin si
    fin para
    retornar resultado
fin funcion

# Convierte ASCII a-z a A-Z. Caracteres no-ASCII se preservan.
funcion mayusculas_ascii(s):
    resultado = ""
    n = longitud(s)
    para i en rango(n):
        c = s[i]
        si c >= "a" y c <= "z":
            resultado = resultado + _ascii_a_may(c)
        sino:
            resultado = resultado + c
        fin si
    fin para
    retornar resultado
fin funcion

# Helpers internos: traducen char a char con offset ±32.
# Sin built-in `chr/ord`, usamos tabla.
_TABLA_MIN = "abcdefghijklmnopqrstuvwxyz"
_TABLA_MAY = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"

funcion _ascii_a_min(c):
    para i en rango(26):
        si c == _TABLA_MAY[i]:
            retornar _TABLA_MIN[i]
        fin si
    fin para
    retornar c
fin funcion

funcion _ascii_a_may(c):
    para i en rango(26):
        si c == _TABLA_MIN[i]:
            retornar _TABLA_MAY[i]
        fin si
    fin para
    retornar c
fin funcion

# Quita espacios en blanco (ASCII: espacio, tab, \n, \r) del inicio
# y final de `s`. La versión Unicode-aware llegará con un built-in
# en versiones futuras.
funcion recortar(s):
    retornar recortar_derecha(recortar_izquierda(s))
fin funcion

funcion recortar_izquierda(s):
    n = longitud(s)
    i = 0
    mientras i < n y _es_blanco(s[i]):
        i = i + 1
    fin mientras
    retornar s[i:]
fin funcion

funcion recortar_derecha(s):
    n = longitud(s)
    i = n
    mientras i > 0 y _es_blanco(s[i - 1]):
        i = i - 1
    fin mientras
    retornar s[:i]
fin funcion

funcion _es_blanco(c):
    retornar c == " " o c == "\t" o c == "\n" o c == "\r"
fin funcion

# Cuenta las apariciones (no solapadas) de `sub` en `s`.
#
# Nota técnica v0.9.1: declaramos `coincide` antes del bucle `mientras`
# en lugar de dentro de su cuerpo. El bytecode de v0.9.x tiene una
# limitación con nuevos locales declarados dentro de cuerpos de bucles
# en función — el slot se desfasa entre iteraciones. La refactorización
# (declarar antes, reasignar dentro) evita el problema. Llega un fix
# completo del compilador en una versión posterior.
funcion contar(s, sub):
    si longitud(sub) == 0:
        retornar 0
    fin si
    cuenta = 0
    ns = longitud(s)
    nb = longitud(sub)
    i = 0
    coincide = falso
    mientras i <= ns - nb:
        coincide = verdadero
        para j en rango(nb):
            si s[i + j] != sub[j]:
                coincide = falso
            fin si
        fin para
        si coincide:
            cuenta = cuenta + 1
            i = i + nb
        sino:
            i = i + 1
        fin si
    fin mientras
    retornar cuenta
fin funcion
