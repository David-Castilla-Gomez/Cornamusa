# Cornamusa stdlib: funcionales.cor
#
# Funciones de orden superior sobre iterables: `mapear`, `filtrar`,
# `reducir`, `enumerar`, `cualquiera`, `todos`. Patrón funcional
# clásico. Las cuatro primeras corresponden a `map`, `filter`,
# `reduce`, `enumerate` de otros lenguajes.
#
# Implementadas en Cornamusa puro (no built-ins) porque las nativas C
# no pueden invocar callables Cornamusa con la firma actual de
# `FnNativa`. La VM resuelve la llamada en el bucle `para`, así que
# este módulo sólo reordena código que el usuario escribiría a mano.
#
# Uso:
#   importar funcionales
#
#   dobles = funcionales.mapear(lambda x: x * 2, [1, 2, 3])     # [2, 4, 6]
#   pares  = funcionales.filtrar(lambda x: x % 2 == 0, rango(10))
#   total  = funcionales.reducir(lambda a, x: a + x, [1, 2, 3], 0)  # 6
#
#   para i, x en funcionales.enumerar(["a", "b", "c"]):
#       imprimir(i, x)
#   fin para
#
# `f`/`p` deben ser callables (funciones, lambdas, closures, métodos
# ligados o instancias con `__llamar__`). Pueden lanzar excepciones,
# que se propagan al llamador sin envoltorio.

# Aplica `f` a cada elemento de `xs` y retorna una lista nueva con
# los resultados. `xs` puede ser cualquier iterable.
funcion mapear(f, xs):
    resultado = []
    para x en xs:
        agregar(resultado, f(x))
    fin para
    retornar resultado
fin funcion

# Retorna lista nueva con los elementos de `xs` para los que `p(x)`
# es verdadero.
funcion filtrar(p, xs):
    resultado = []
    para x en xs:
        si p(x):
            agregar(resultado, x)
        fin si
    fin para
    retornar resultado
fin funcion

# Pliega `xs` con `f`: f(f(f(inicial, xs[0]), xs[1]), xs[2])...
# Si `xs` es vacío retorna `inicial`.
funcion reducir(f, xs, inicial):
    acc = inicial
    para x en xs:
        acc = f(acc, x)
    fin para
    retornar acc
fin funcion

# Genera lista de tuplas (índice, elemento). `inicio` es 0 por defecto;
# pasar otro valor para empezar en una posición distinta.
# (v1.17: argumentos por defecto soportados en bytecode.)
funcion enumerar(xs, inicio=0):
    resultado = []
    i = inicio
    para x en xs:
        agregar(resultado, (i, x))
        i = i + 1
    fin para
    retornar resultado
fin funcion

# Verdadero si `p(x)` lo es para algún elemento. Cortocircuita.
funcion cualquiera(p, xs):
    para x en xs:
        si p(x):
            retornar verdadero
        fin si
    fin para
    retornar falso
fin funcion

# Verdadero si `p(x)` lo es para todos los elementos. Cortocircuita
# en cuanto encuentra uno falso. Vacío → verdadero (vacuamente cierto).
funcion todos(p, xs):
    para x en xs:
        si no p(x):
            retornar falso
        fin si
    fin para
    retornar verdadero
fin funcion

# ─── Agregaciones ─────────────────────────────────────────────────
# `suma`, `minimo`, `maximo` operan con los operadores `+`, `<`, `>`
# que la VM despacha — funcionan sobre enteros, decimales y cualquier
# clase con dunders aritméticos sin necesidad de soporte específico.

# Suma todos los elementos de `xs`. `inicial` por defecto es 0; para
# sumar cadenas o concatenar listas pasa `inicial=""` o `inicial=[]`.
funcion suma(xs, inicial=0):
    total = inicial
    para x en xs:
        total = total + x
    fin para
    retornar total
fin funcion

# Mínimo y máximo de un iterable no vacío. ErrorDeValor si está vacío.
funcion minimo(xs):
    primero = verdadero
    actual = nulo
    para x en xs:
        si primero:
            actual = x
            primero = falso
        sino si x < actual:
            actual = x
        fin si
    fin para
    si primero:
        lanzar ErrorDeValor("minimo() de iterable vacio")
    fin si
    retornar actual
fin funcion

funcion maximo(xs):
    primero = verdadero
    actual = nulo
    para x en xs:
        si primero:
            actual = x
            primero = falso
        sino si x > actual:
            actual = x
        fin si
    fin para
    si primero:
        lanzar ErrorDeValor("maximo() de iterable vacio")
    fin si
    retornar actual
fin funcion

# ─── Helpers de coleccion (v1.87) ─────────────────────────────────

# Agrupa los elementos de `xs` por la clave que devuelve `f(x)`.
# Devuelve un diccionario `{clave: lista_de_elementos}`. El orden
# de las claves es el orden de primera aparicion (Python 3.7+).
#
# Ejemplo:
#   agrupar_por([1, 2, 3, 4, 5], lambda x: x % 2)
#   → {1: [1, 3, 5], 0: [2, 4]}
funcion agrupar_por(xs, f):
    grupos = {}
    para x en xs:
        k = f(x)
        si k en grupos:
            agregar(grupos[k], x)
        sino:
            grupos[k] = [x]
        fin si
    fin para
    retornar grupos
fin funcion

# Devuelve los primeros `n` elementos de `xs` como lista. Si `xs`
# tiene menos de `n`, devuelve todos los disponibles (no lanza).
# Funciona con cualquier iterable incluyendo generadores infinitos.
funcion tomar(n, xs):
    resultado = []
    si n <= 0:
        retornar resultado
    fin si
    contador = 0
    para x en xs:
        agregar(resultado, x)
        contador = contador + 1
        si contador >= n:
            romper
        fin si
    fin para
    retornar resultado
fin funcion

# Devuelve `xs` sin los primeros `n` elementos. Si `n` >= longitud,
# devuelve lista vacia. Funciona con cualquier iterable.
funcion saltar(n, xs):
    resultado = []
    contador = 0
    para x en xs:
        si contador < n:
            contador = contador + 1
            continuar
        fin si
        agregar(resultado, x)
    fin para
    retornar resultado
fin funcion

# Combina (zip) dos iterables en una lista de pares. Se detiene
# cuando el mas corto se agota.
#
# Ejemplo:
#   combinar(["a", "b", "c"], [1, 2, 3])
#   → [("a", 1), ("b", 2), ("c", 3)]
funcion combinar(xs, ys):
    # Convertir a listas para poder indexar (la solucion mas simple).
    xs_lista = lista(xs)
    ys_lista = lista(ys)
    n = minimo([longitud(xs_lista), longitud(ys_lista)])
    resultado = []
    para i en rango(n):
        agregar(resultado, (xs_lista[i], ys_lista[i]))
    fin para
    retornar resultado
fin funcion

# Aplana un nivel: `[[1,2],[3,4]]` → `[1,2,3,4]`. Solo un nivel —
# para multiples niveles, llamala varias veces o escribe una
# version recursiva tu mismo.
funcion aplanar(xs):
    resultado = []
    para sublista en xs:
        para x en sublista:
            agregar(resultado, x)
        fin para
    fin para
    retornar resultado
fin funcion

# Elementos unicos preservando el orden de primera aparicion.
# Equivalente a `lista(conjunto(xs))` pero garantiza el orden.
funcion unicos(xs):
    vistos = conjunto()
    resultado = []
    para x en xs:
        si x en vistos:
            continuar
        fin si
        agregar(vistos, x)
        agregar(resultado, x)
    fin para
    retornar resultado
fin funcion
