# Cornamusa stdlib: azar.cor
#
# Números pseudoaleatorios de calidad estadística (motor xoshiro256**
# en C). Cubre las primitivas comunes para juegos, simulación, muestreo
# y testing.
#
# Uso:
#   importar azar
#
#   azar.semilla(42)             # determinismo para tests
#   x = azar.decimal()           # uniforme en [0, 1)
#   n = azar.entero(1, 100)      # uniforme en [1, 100]
#   c = azar.elegir(["rojo", "verde", "azul"])
#   azar.barajar(lista)          # in-place, Fisher-Yates
#   m = azar.muestra([1..50], 5) # 5 sin reemplazo
#
# Notas:
#   - El estado del PRNG es global del proceso. La semilla inicial usa
#     el reloj.
#   - `barajar` muta la lista; `muestra` devuelve una nueva.
#   - Para distribución normal, ver TODO en `normal()` abajo.

# Uniforme [0.0, 1.0). 53 bits de mantisa.
funcion decimal():
    retornar azar_decimal()
fin funcion

# Uniforme entero en [a, b], inclusive en ambos extremos.
funcion entero(a, b):
    retornar azar_entero(a, b)
fin funcion

# Re-siembra el PRNG (útil para reproducibilidad en tests).
funcion semilla(n):
    retornar azar_semilla(n)
fin funcion

# Elige un elemento al azar de una secuencia indexable (lista o tupla).
# Lanza ErrorDeValor si la secuencia es vacía.
funcion elegir(seq):
    n = longitud(seq)
    si n == 0:
        lanzar ErrorDeValor("azar.elegir: secuencia vacia")
    fin si
    retornar seq[azar_entero(0, n - 1)]
fin funcion

# Baraja una lista in-place vía Fisher-Yates (Knuth). Retorna la
# misma lista por conveniencia. La lista se modifica.
funcion barajar(lista):
    n = longitud(lista)
    i = n - 1
    mientras i > 0:
        j = azar_entero(0, i)
        tmp = lista[i]
        lista[i] = lista[j]
        lista[j] = tmp
        i = i - 1
    fin mientras
    retornar lista
fin funcion

# Muestra `k` elementos de `seq` sin reemplazo. Devuelve una lista
# nueva. Si k > longitud(seq), lanza ErrorDeValor.
funcion muestra(seq, k):
    n = longitud(seq)
    si k < 0:
        lanzar ErrorDeValor("azar.muestra: k negativo")
    fin si
    si k > n:
        lanzar ErrorDeValor("azar.muestra: k mayor que la secuencia")
    fin si
    # Copia indices y selecciona los primeros k tras barajar parcialmente.
    indices = []
    i = 0
    mientras i < n:
        agregar(indices, i)
        i = i + 1
    fin mientras
    resultado = []
    i = 0
    mientras i < k:
        # Saca un indice aleatorio entre [i, n-1] y intercambia con i.
        j = azar_entero(i, n - 1)
        idx = indices[j]
        indices[j] = indices[i]
        indices[i] = idx
        agregar(resultado, seq[idx])
        i = i + 1
    fin mientras
    retornar resultado
fin funcion

# Booleano al azar con probabilidad `p` de ser verdadero.
# Default 0.5 (moneda).
funcion booleano(p=0.5):
    retornar azar_decimal() < p
fin funcion

# Devuelve un decimal uniforme en [a, b).
funcion uniforme(a, b):
    si a >= b:
        retornar a
    fin si
    retornar a + (b - a) * azar_decimal()
fin funcion

# Devuelve un decimal de distribucion normal (Gaussiana) con media
# `mu` y desviacion estandar `sigma`. Implementacion Box-Muller
# transform: dadas dos uniformes U1, U2 en (0, 1], se obtiene una
# muestra normal estandar Z = sqrt(-2 ln U1) cos(2 pi U2), y luego
# se escala: mu + sigma * Z.
#
# El otro componente sin(2 pi U2) se descarta (mas simple que
# cachear). Cada llamada usa dos uniformes; el costo es bajo.
#
# Ejemplo: simular 1000 alturas con media 170cm y desv 8cm:
#   muestras = []
#   para i en rango(0, 1000):
#       agregar(muestras, azar.normal(170, 8))
#   fin para
#
# `mu` y `sigma` deben ser numericos. `sigma` debe ser >= 0;
# sigma == 0 devuelve `mu` exacto sin sortear.
funcion normal(mu, sigma):
    importar matematicas
    si sigma == 0:
        retornar mu * 1.0
    fin si
    si sigma < 0:
        lanzar ErrorDeValor("normal: sigma debe ser >= 0")
    fin si
    # Evitar log(0) garantizando u1 estrictamente > 0.
    # azar_decimal() devuelve [0, 1); rechazamos el 0 reintentando.
    u1 = azar_decimal()
    mientras u1 == 0:
        u1 = azar_decimal()
    fin mientras
    u2 = azar_decimal()
    z = matematicas.raiz(-2.0 * matematicas.ln(u1)) *
        matematicas.coseno(2.0 * matematicas.PI * u2)
    retornar mu + sigma * z
fin funcion


# ─── v1.110: distribuciones adicionales ─────────────────────────
#
# `exponencial(tasa)` - distribucion exponencial con parametro `tasa`
# (lambda en notacion estandar). Media = 1/tasa. Util para tiempos
# entre eventos en procesos Poisson, vidas utiles, etc.
# Metodo: -ln(U)/tasa donde U ~ Uniform(0, 1).
funcion exponencial(tasa):
    importar matematicas
    si tasa <= 0:
        lanzar ErrorDeValor("exponencial: tasa debe ser > 0")
    fin si
    u = azar_decimal()
    mientras u == 0:
        u = azar_decimal()
    fin mientras
    retornar -matematicas.ln(u) / tasa
fin funcion


# `binomial(n, p)` - distribucion binomial con `n` ensayos y
# probabilidad `p` de exito por ensayo. Retorna numero de exitos
# en {0, 1, ..., n}.
# Metodo directo: suma de n Bernoulli(p). O(n) — para n grande
# podria usarse aproximacion normal/Poisson, pero para n <= 10000
# este metodo es suficiente.
funcion binomial(n, p):
    si tipo(n) != "entero":
        lanzar ErrorDeTipo("binomial: n debe ser entero")
    fin si
    si n < 0:
        lanzar ErrorDeValor("binomial: n debe ser >= 0")
    fin si
    si p < 0 o p > 1:
        lanzar ErrorDeValor("binomial: p debe estar en [0, 1]")
    fin si
    exitos = 0
    para i en rango(0, n):
        si azar_decimal() < p:
            exitos = exitos + 1
        fin si
    fin para
    retornar exitos
fin funcion


# `poisson(media)` - distribucion Poisson con media `media` (lambda).
# Retorna entero >= 0.
# Metodo: algoritmo de Knuth (multiplicar uniformes hasta superar
# e^-media). Buen rendimiento para media <= 30; para valores mayores
# podria usarse PTRS o normal approx, pero esos casos son raros.
funcion poisson(media):
    importar matematicas
    si media < 0:
        lanzar ErrorDeValor("poisson: media debe ser >= 0")
    fin si
    si media == 0:
        retornar 0
    fin si
    limite = matematicas.exp(-media)
    k = 0
    p = 1.0
    mientras verdadero:
        k = k + 1
        p = p * azar_decimal()
        si p <= limite:
            romper
        fin si
    fin mientras
    retornar k - 1
fin funcion
