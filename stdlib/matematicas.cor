# Cornamusa stdlib: matematicas.cor
#
# Constantes y funciones matemáticas básicas, escritas en Cornamusa
# puro. Para funciones que requieren primitivas C (sin, cos, raiz, etc.)
# se necesitará una stdlib más rica con bindings nativos en versiones
# futuras.
#
# Uso:
#   importar matematicas
#   imprimir(matematicas.PI)
#   imprimir(matematicas.cuadrado(5))

# Constantes
PI = 3.141592653589793
E  = 2.718281828459045

# Operaciones simples
funcion cuadrado(n):
    retornar n * n
fin funcion

funcion cubo(n):
    retornar n * n * n
fin funcion

funcion absoluto(n):
    si n < 0:
        retornar -n
    fin si
    retornar n
fin funcion

funcion maximo(a, b):
    si a > b:
        retornar a
    fin si
    retornar b
fin funcion

funcion minimo(a, b):
    si a < b:
        retornar a
    fin si
    retornar b
fin funcion

funcion signo(n):
    si n > 0:
        retornar 1
    fin si
    si n < 0:
        retornar -1
    fin si
    retornar 0
fin funcion

# Factorial recursivo (con bignum: factorial(100) funciona).
funcion factorial(n):
    si n < 0:
        lanzar ErrorDeValor("factorial requiere n >= 0")
    fin si
    si n == 0:
        retornar 1
    fin si
    retornar n * factorial(n - 1)
fin funcion

# Suma de los enteros desde inicio hasta fin (excluido).
funcion suma_rango(a, b):
    total = 0
    para i en rango(a, b):
        total = total + i
    fin para
    retornar total
fin funcion

# Verifica si n es par.
funcion es_par(n):
    retornar (n % 2) == 0
fin funcion

# Verifica si n es impar.
funcion es_impar(n):
    retornar (n % 2) != 0
fin funcion

# Mayor común divisor (algoritmo de Euclides).
funcion mcd(a, b):
    a = absoluto(a)
    b = absoluto(b)
    mientras b != 0:
        temp = b
        b = a % b
        a = temp
    fin mientras
    retornar a
fin funcion

# ─── v1.103: trigonometria, raiz, log, exp, redondeo ────────────
#
# Wrappers sobre las nativas C (libm). Aceptan entero/decimal/booleano
# y devuelven decimal. Los argumentos en angulo van en RADIANES.
# Errores tipicos lanzan ErrorDeValor atrapable.
#
# Constantes ya disponibles: PI, E (definidas arriba).

# Raiz cuadrada. Lanza ErrorDeValor para argumentos negativos.
funcion raiz(x):
    retornar mat_raiz(x)
fin funcion

# Logaritmo natural (base e). Lanza ErrorDeValor si x <= 0.
funcion ln(x):
    retornar mat_ln(x)
fin funcion

# Logaritmo base 10. Lanza ErrorDeValor si x <= 0.
funcion log10(x):
    retornar mat_log10(x)
fin funcion

# Logaritmo en base arbitraria. log_b(x) = ln(x) / ln(b).
funcion log(x, base):
    retornar mat_ln(x) / mat_ln(base)
fin funcion

# Exponencial: e^x.
funcion exp(x):
    retornar mat_exp(x)
fin funcion

# Potencia: x^expo. Tambien hay el operador `**`.
funcion potencia(x, expo):
    retornar mat_potencia(x, expo)
fin funcion

# Trigonometria. Argumento en radianes.
funcion seno(x):
    retornar mat_seno(x)
fin funcion

funcion coseno(x):
    retornar mat_coseno(x)
fin funcion

funcion tangente(x):
    retornar mat_tangente(x)
fin funcion

# Inversas. arco_seno y arco_coseno requieren x en [-1, 1].
# arco_tangente acepta cualquier x. arco_tangente2(y, x) maneja
# cuadrantes correctamente (range completo [-PI, PI]).
funcion arco_seno(x):
    retornar mat_arco_seno(x)
fin funcion

funcion arco_coseno(x):
    retornar mat_arco_coseno(x)
fin funcion

funcion arco_tangente(x):
    retornar mat_arco_tangente(x)
fin funcion

funcion arco_tangente2(dy, dx):
    retornar mat_arco_tangente2(dy, dx)
fin funcion

# Redondeo.
# `techo(3.2) == 4`, `suelo(3.8) == 3`.
# `redondear(3.5) == 4`, `redondear(-2.5) == -3` (half-away-from-zero).
funcion techo(x):
    retornar mat_techo(x)
fin funcion

funcion suelo(x):
    retornar mat_suelo(x)
fin funcion

funcion redondear(x):
    retornar mat_redondear(x)
fin funcion

# Conversion grados <-> radianes.
funcion grados_a_radianes(g):
    retornar g * PI / 180.0
fin funcion

funcion radianes_a_grados(r):
    retornar r * 180.0 / PI
fin funcion

# Hipotenusa: sqrt(a^2 + b^2). Mas estable numericamente que
# raiz(a*a + b*b) para valores grandes.
funcion hipotenusa(a, b):
    retornar mat_raiz(a * a + b * b)
fin funcion
