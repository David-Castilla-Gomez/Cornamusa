# Cornamusa stdlib: ruta.cor (v1.94)
#
# Manipulacion lexicografica de rutas de archivo al estilo de
# `pathlib.PurePath` de Python. Pure-Cornamusa: NO toca el sistema
# de archivos (excepto `existe()`, que delega a `archivos.existe`).
#
# Separador canonico: `/`. La clase acepta tambien `\` en la entrada
# (lo normaliza). Para Windows, usar `/` o las APIs nativas
# correspondientes.
#
# Uso tipico:
#
#   importar ruta
#
#   r = ruta.Ruta("/home/david/docs/notas.txt")
#   r.nombre()               # "notas.txt"
#   r.tronco()               # "notas"
#   r.extension()            # ".txt"
#   r.padre().cadena()       # "/home/david/docs"
#   r.partes()               # ["/", "home", "david", "docs", "notas.txt"]
#   r.absoluta()             # verdadero
#
#   nueva = r.con_extension(".md")
#   imprimir(nueva.cadena()) # "/home/david/docs/notas.md"
#
#   sub = ruta.Ruta("/etc").unir("nginx").unir("conf.d")
#   imprimir(sub.cadena())   # "/etc/nginx/conf.d"
#
#   si r.existe():
#       imprimir("Si existe")
#   fin si
#
# Helpers de modulo (sin instanciar):
#
#   ruta.unir_partes(["a", "b", "c"])     # "a/b/c"
#   ruta.normalizar("a/./b/../c")         # "a/c"
#   ruta.es_absoluta("/etc")              # verdadero
#   ruta.nombre("/x/y/z.txt")             # "z.txt"
#   ruta.extension("/x/y.tar.gz")         # ".gz"
#   ruta.tronco("foo.cor")                # "foo"

importar archivos
importar cadenas


# ─── Helpers internos (prefijo _) ───────────────────────────────

funcion _normalizar_sep(s):
    salida = ""
    para c en s:
        si c == "\\":
            salida = salida + "/"
        sino:
            salida = salida + c
        fin si
    fin para
    retornar salida
fin funcion


funcion _partir(s):
    # Devuelve lista de componentes. Si la ruta es absoluta,
    # el primer elemento es "/". Componentes vacios entre "//"
    # se descartan.
    s = _normalizar_sep(s)
    partes = []
    si longitud(s) > 0 y s[0] == "/":
        agregar(partes, "/")
    fin si
    actual = ""
    para c en s:
        si c == "/":
            si longitud(actual) > 0:
                agregar(partes, actual)
                actual = ""
            fin si
        sino:
            actual = actual + c
        fin si
    fin para
    si longitud(actual) > 0:
        agregar(partes, actual)
    fin si
    retornar partes
fin funcion


funcion _unir_partes_lista(partes):
    si longitud(partes) == 0:
        retornar ""
    fin si
    si partes[0] == "/":
        resto = []
        para i en rango(1, longitud(partes)):
            agregar(resto, partes[i])
        fin para
        retornar "/" + cadenas.unir(resto, "/")
    fin si
    retornar cadenas.unir(partes, "/")
fin funcion


funcion _nombre_de(s):
    partes = _partir(s)
    n = longitud(partes)
    si n == 0:
        retornar ""
    fin si
    ultimo = partes[n - 1]
    si ultimo == "/":
        retornar ""
    fin si
    retornar ultimo
fin funcion


funcion _split_ext(nombre):
    # Devuelve [tronco, ext]. ext es el sufijo desde el ULTIMO '.',
    # siempre que ese '.' no este en la posicion 0 (archivos como
    # ".gitignore" se consideran sin extension).
    si longitud(nombre) == 0:
        retornar ["", ""]
    fin si
    idx = -1
    i = longitud(nombre) - 1
    mientras i >= 1:
        si nombre[i] == ".":
            idx = i
            romper
        fin si
        i = i - 1
    fin mientras
    si idx == -1:
        retornar [nombre, ""]
    fin si
    tronco = ""
    para j en rango(0, idx):
        tronco = tronco + nombre[j]
    fin para
    ext = ""
    para j en rango(idx, longitud(nombre)):
        ext = ext + nombre[j]
    fin para
    retornar [tronco, ext]
fin funcion


funcion _padre_de(s):
    partes = _partir(s)
    n = longitud(partes)
    si n == 0:
        retornar ""
    fin si
    si n == 1:
        si partes[0] == "/":
            retornar "/"
        fin si
        retornar ""
    fin si
    sin_ultimo = []
    para i en rango(0, n - 1):
        agregar(sin_ultimo, partes[i])
    fin para
    retornar _unir_partes_lista(sin_ultimo)
fin funcion


funcion _es_absoluta(s):
    si tipo(s) != "cadena" o longitud(s) == 0:
        retornar falso
    fin si
    primero = s[0]
    si primero == "/" o primero == "\\":
        retornar verdadero
    fin si
    si longitud(s) >= 2 y s[1] == ":":
        retornar verdadero
    fin si
    retornar falso
fin funcion


# ─── API funcional de modulo ─────────────────────────────────────

funcion es_absoluta(s):
    retornar _es_absoluta(s)
fin funcion


funcion nombre(s):
    retornar _nombre_de(s)
fin funcion


funcion tronco(s):
    par = _split_ext(_nombre_de(s))
    retornar par[0]
fin funcion


funcion extension(s):
    par = _split_ext(_nombre_de(s))
    retornar par[1]
fin funcion


funcion padre(s):
    retornar _padre_de(s)
fin funcion


funcion partes(s):
    retornar _partir(s)
fin funcion


funcion unir_partes(lista_partes):
    # Une una lista de cadenas con "/". Si alguna parte intermedia
    # es absoluta, descarta lo anterior (igual que `os.path.join`).
    resultado = ""
    para p en lista_partes:
        si _es_absoluta(p):
            resultado = p
        sino:
            si longitud(resultado) == 0:
                resultado = p
            sino:
                ultimo = resultado[longitud(resultado) - 1]
                si ultimo == "/":
                    resultado = resultado + p
                sino:
                    resultado = resultado + "/" + p
                fin si
            fin si
        fin si
    fin para
    retornar _normalizar_sep(resultado)
fin funcion


funcion normalizar(s):
    # Resuelve "." y ".." lexicograficamente. NO toca FS.
    partes = _partir(s)
    resultado = []
    para p en partes:
        si p == ".":
            # skip
        sino:
            si p == "..":
                n = longitud(resultado)
                si n == 0:
                    agregar(resultado, "..")
                sino:
                    ultimo = resultado[n - 1]
                    si ultimo == "/":
                        # No se puede subir mas alla de la raiz
                    sino:
                        si ultimo == "..":
                            agregar(resultado, "..")
                        sino:
                            nuevo = []
                            para i en rango(0, n - 1):
                                agregar(nuevo, resultado[i])
                            fin para
                            resultado = nuevo
                        fin si
                    fin si
                fin si
            sino:
                agregar(resultado, p)
            fin si
        fin si
    fin para
    si longitud(resultado) == 0:
        retornar "."
    fin si
    retornar _unir_partes_lista(resultado)
fin funcion


# ─── Glob matcher (v1.100) ───────────────────────────────────────
#
# Soporta dos metacaracteres clasicos:
#   *    cero o mas caracteres (cualquiera, NO incluye separadores)
#   ?    exactamente un caracter
# No soporta `**` recursivo, ni clases `[abc]`, ni alternancias.
# Para necesidades mas complejas, usar `stdlib/regex`.
#
# Implementacion: dos punteros + backtracking en `*`. O(n*m) en el
# peor caso. Suficiente para patrones tipicos (`*.cor`, `test_*.txt`).

funcion _coincide_glob(s, p):
    si_p = 0
    pi_p = 0
    estrella_s = -1
    estrella_p = -1
    n_s = longitud(s)
    n_p = longitud(p)
    mientras si_p < n_s:
        si pi_p < n_p y (p[pi_p] == "?" o p[pi_p] == s[si_p]):
            si_p = si_p + 1
            pi_p = pi_p + 1
        sino:
            si pi_p < n_p y p[pi_p] == "*":
                estrella_p = pi_p
                estrella_s = si_p
                pi_p = pi_p + 1
            sino:
                si estrella_p != -1:
                    pi_p = estrella_p + 1
                    estrella_s = estrella_s + 1
                    si_p = estrella_s
                sino:
                    retornar falso
                fin si
            fin si
        fin si
    fin mientras
    # Consumir asteriscos al final del patron
    mientras pi_p < n_p y p[pi_p] == "*":
        pi_p = pi_p + 1
    fin mientras
    retornar pi_p >= n_p
fin funcion


# ─── Recorrido recursivo del filesystem (v1.100) ─────────────────
#
# `recorrer(directorio)` devuelve una LISTA (no generador) con
# todas las Rutas alcanzables desde `directorio`, recursivamente,
# en orden DFS. Incluye archivos Y directorios. NO sigue symlinks
# (depende de la implementacion del FS subyacente).
#
# `encontrar(directorio, patron)` filtra `recorrer` por el nombre
# (no la ruta completa) usando el matcher glob.
#
# Limites: si el arbol es enorme, todo se carga en memoria. Para
# arboles grandes el patron recomendado es `recorrer` y procesar
# manualmente filtrando in-flight.

funcion recorrer(directorio):
    salida = []
    _recorrer_aux(directorio, salida)
    retornar salida
fin funcion


funcion _recorrer_aux(directorio_str, salida):
    # `directorio_str` puede ser cadena o Ruta. Normalizamos.
    si tipo(directorio_str) == "instancia":
        d_str = directorio_str.s
    sino:
        d_str = directorio_str
    fin si
    # Pre-declarar `entradas` para que sobreviva al `intentar`.
    # En cornamusa las variables declaradas dentro de un `intentar`
    # NO escapan al scope exterior (sub-scope).
    entradas = []
    fallo = falso
    intentar:
        entradas = archivos.listar(d_str)
    atrapar ErrorDeIO como e:
        fallo = verdadero
    fin intentar
    si fallo:
        retornar nulo
    fin si
    para nombre en entradas:
        sub = Ruta(unir_partes([d_str, nombre]))
        agregar(salida, sub)
        si sub.es_directorio():
            _recorrer_aux(sub.s, salida)
        fin si
    fin para
fin funcion


funcion encontrar(directorio, patron):
    # Devuelve lista de Rutas cuyo NOMBRE (ultimo componente)
    # coincide con `patron`. Recorre todo el arbol.
    coincidencias = []
    para r en recorrer(directorio):
        si _coincide_glob(r.nombre(), patron):
            agregar(coincidencias, r)
        fin si
    fin para
    retornar coincidencias
fin funcion


# ─── Clase Ruta (envoltorio OO) ──────────────────────────────────

clase Ruta:
    funcion __iniciar__(yo, s):
        yo.s = _normalizar_sep(s)
    fin funcion

    funcion __cadena__(yo):
        retornar yo.s
    fin funcion

    funcion cadena(yo):
        retornar yo.s
    fin funcion

    funcion __igual__(yo, otro):
        si tipo(otro) != "instancia":
            retornar falso
        fin si
        retornar yo.s == otro.s
    fin funcion

    funcion nombre(yo):
        retornar _nombre_de(yo.s)
    fin funcion

    funcion tronco(yo):
        par = _split_ext(_nombre_de(yo.s))
        retornar par[0]
    fin funcion

    funcion extension(yo):
        par = _split_ext(_nombre_de(yo.s))
        retornar par[1]
    fin funcion

    funcion padre(yo):
        retornar Ruta(_padre_de(yo.s))
    fin funcion

    funcion partes(yo):
        retornar _partir(yo.s)
    fin funcion

    funcion absoluta(yo):
        retornar _es_absoluta(yo.s)
    fin funcion

    funcion vacia(yo):
        retornar longitud(yo.s) == 0
    fin funcion

    funcion unir(yo, otro):
        # Otro puede ser cadena o instancia Ruta.
        si tipo(otro) == "instancia":
            otro_s = otro.s
        sino:
            otro_s = otro
        fin si
        retornar Ruta(unir_partes([yo.s, otro_s]))
    fin funcion

    funcion con_nombre(yo, nuevo):
        pad = _padre_de(yo.s)
        si longitud(pad) == 0:
            retornar Ruta(nuevo)
        fin si
        retornar Ruta(unir_partes([pad, nuevo]))
    fin funcion

    funcion con_extension(yo, nueva_ext):
        # nueva_ext debe empezar por '.' (o cadena vacia para quitar).
        n = _nombre_de(yo.s)
        par = _split_ext(n)
        nuevo_nombre = par[0] + nueva_ext
        retornar yo.con_nombre(nuevo_nombre)
    fin funcion

    funcion normalizada(yo):
        retornar Ruta(normalizar(yo.s))
    fin funcion

    funcion existe(yo):
        # v1.97: ahora cubre archivos Y directorios.
        si archivos.existe(yo.s):
            retornar verdadero
        fin si
        retornar archivos.es_directorio(yo.s)
    fin funcion

    funcion es_archivo(yo):
        # v1.97. Verdadero si existe y es archivo regular.
        retornar archivos.existe(yo.s)
    fin funcion

    funcion es_directorio(yo):
        # v1.97. Verdadero si existe y es directorio.
        retornar archivos.es_directorio(yo.s)
    fin funcion

    funcion listar(yo):
        # v1.97. Lista las entradas inmediatas como cadenas (sin
        # recursion, sin "." ni ".."). Lanza ErrorDeIO si no es
        # un directorio accesible.
        retornar archivos.listar(yo.s)
    fin funcion

    funcion listar_rutas(yo):
        # v1.97. Como `listar` pero devuelve Rutas (la ruta del
        # directorio actual unida a cada entrada).
        entradas = archivos.listar(yo.s)
        salida = []
        para nombre en entradas:
            agregar(salida, yo.unir(nombre))
        fin para
        retornar salida
    fin funcion

    # v1.99: borrado y metadata. Nota: usamos `eliminar` en lugar
    # de `borrar` porque `borrar` es keyword del lenguaje (`borrar
    # d[k]`, `borrar obj.attr`).

    funcion eliminar(yo):
        # Quita el archivo. Lanza ErrorDeIO si la ruta es un
        # directorio o no existe. Para directorios usar
        # `eliminar_directorio`.
        archivos.eliminar(yo.s)
    fin funcion

    funcion eliminar_directorio(yo):
        # Quita el directorio (debe estar VACIO). Lanza ErrorDeIO
        # si no esta vacio, no existe, o no es directorio.
        archivos.eliminar_directorio(yo.s)
    fin funcion

    funcion info(yo):
        # Devuelve dict con {tamano, mtime_epoch_ms, es_archivo,
        # es_directorio}. Lanza ErrorDeIO si la ruta no existe.
        retornar archivos.info(yo.s)
    fin funcion

    funcion tamano(yo):
        # Atajo a info["tamano"]. Bytes.
        retornar archivos.info(yo.s)["tamano"]
    fin funcion

    funcion mtime_ms(yo):
        # Atajo a info["mtime_epoch_ms"]. Milisegundos epoch.
        retornar archivos.info(yo.s)["mtime_epoch_ms"]
    fin funcion

    # v1.100: recorrido y busqueda.

    funcion recorrer(yo):
        # Lista de Rutas alcanzables desde `yo` recursivamente (DFS).
        # Incluye archivos Y directorios. Si `yo` no es directorio,
        # retorna lista vacia.
        salida = []
        _recorrer_aux(yo.s, salida)
        retornar salida
    fin funcion

    funcion encontrar(yo, patron):
        # Como `recorrer` pero filtrado por glob sobre el nombre
        # del ultimo componente (`*.cor`, `test_*.txt`, ...).
        salida = []
        _recorrer_aux(yo.s, salida)
        coincidencias = []
        para r en salida:
            si _coincide_glob(r.nombre(), patron):
                agregar(coincidencias, r)
            fin si
        fin para
        retornar coincidencias
    fin funcion

    funcion coincide(yo, patron):
        # Verdadero si el nombre de `yo` matchea `patron` glob.
        # Util para filtrar manualmente o comprobar un solo path.
        retornar _coincide_glob(yo.nombre(), patron)
    fin funcion

    # v1.102: borrado recursivo y mkdir -p.

    funcion eliminar_arbol(yo):
        # Borra el arbol entero (rm -rf). Lanza ErrorDeValor si la
        # ruta interna es vacia o un separador raiz. Para archivos
        # regulares, fallback a `eliminar`. Lanza ErrorDeIO si no
        # existe.
        archivos.eliminar_arbol(yo.s)
    fin funcion

    funcion crear_arbol(yo):
        # Crea el directorio y todos sus padres (mkdir -p).
        # Idempotente: si ya existe, no falla.
        archivos.crear_arbol(yo.s)
    fin funcion
fin clase


# ─── Helpers de modulo FS (v1.97) ────────────────────────────────

funcion cwd():
    # Devuelve una `Ruta` con el directorio actual.
    retornar Ruta(archivos.directorio_actual())
fin funcion
